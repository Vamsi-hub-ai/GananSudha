# Production Vite Frontend Configuration
# If the React frontend is served alongside the Node.js backend on Hostinger, relative paths like /api and /uploads are used automatically.
# If hosted on separate subdomains (e.g., app.gnanasudha.com and api.gnanasudha.com), set the full URL below:
VITE_API_URL="https://gnanasudha.com/api"
VITE_STORAGE_URL="https://gnanasudha.com"
